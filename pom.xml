<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.7</version>
    <relativePath/>
  </parent>

  <groupId>com.datavvy.vms</groupId>
  <artifactId>vms-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>VMS backend (modular monolith)</name>

  <!--
    One Maven module per bounded context. A module may depend on another
    module's artifact, but code may only use that module's `api` package
    (enforced by ArchitectureTest in vms-app). See docs/architecture.md.
  -->
  <modules>
    <module>vms-platform</module>
    <module>vms-auth</module>
    <module>vms-catalog</module>
    <module>vms-vehicle</module>
    <module>vms-dashboard</module>
    <module>vms-app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <springdoc.version>2.8.13</springdoc.version>
    <archunit.version>1.4.1</archunit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.datavvy.vms</groupId>
        <artifactId>vms-platform</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.datavvy.vms</groupId>
        <artifactId>vms-auth</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.datavvy.vms</groupId>
        <artifactId>vms-catalog</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.datavvy.vms</groupId>
        <artifactId>vms-vehicle</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.datavvy.vms</groupId>
        <artifactId>vms-dashboard</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Every module gets the same test toolkit. -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
