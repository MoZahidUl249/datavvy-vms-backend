# Local settings for the run-*.command scripts and `docker compose`.
# Copy to `.env` (git-ignored) and fill in. The scripts create `.env` from this
# file with random passwords on first run, so you rarely need to edit it.
# Values are single-quoted so the file works for both bash and docker compose.
#
# Servers (Render, CI) don't use this file: set the same variables in the
# host's environment settings instead.

# Database (MySQL 8 or compatible). Not needed when the scripts fall back to H2.
VMS_DB_URL='jdbc:mysql://localhost:3306/vms?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC'
VMS_DB_USER='vms'
VMS_DB_PASSWORD='change-me'
# Only used by the MySQL container in docker-compose.yml.
MYSQL_ROOT_PASSWORD='change-me-too'

# Signs login tokens. 32+ random characters: openssl rand -base64 48
VMS_JWT_SECRET='change-me-to-32-or-more-random-characters'

# Browser origins allowed to call the API (comma-separated, * wildcards allowed).
VMS_CORS_ORIGINS='http://localhost:*,http://127.0.0.1:*'

